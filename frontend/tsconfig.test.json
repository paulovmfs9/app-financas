{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2020"],
    "outDir": ".test-build",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/services/MonetizationService.ts",
    "src/services/MonetizationService.test.ts",
    "src/models/User.ts",
    "src/utils/format.ts",
    "src/utils/theme.ts",
    "src/utils/theme.test.ts",
    "src/utils/finance.ts",
    "src/utils/finance.test.ts"
  ]
}
